# StockSage AI — Environment Variables
# Copy this to .env and fill in real values

# ── Database ──────────────────────────────────────────────────
# PostgreSQL is required in development and production:
DATABASE_URL="postgresql://user:password@host:5432/stocksage?schema=public"
# Production Railway DB URL — used by scratch_backfill_deals.ts --prod flag
PROD_DATABASE_URL=""

# ── Auth ──────────────────────────────────────────────────────
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
CORS_ALLOWED_ORIGINS="http://localhost:5173"
ADMIN_EMAILS="admin@example.com"

# ── AI ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Broker secrets are server-only. Do not store them in frontend variables or files.
BROKER_PROVIDER="paper"
KITE_API_KEY=""
KITE_API_SECRET=""
KITE_ACCESS_TOKEN=""

# Dhan market-data authentication. DHAN_ACCESS_TOKEN is an optional one-time
# bootstrap token; it is not the API secret. For automatic 24-hour rotation,
# enable TOTP in Dhan and provide all three renewal secrets below.
DHAN_CLIENT_ID=""
DHAN_ACCESS_TOKEN=""
DHAN_AUTO_TOKEN_RENEWAL="true"
DHAN_PIN=""
DHAN_TOTP_SECRET=""
# Exactly 32 random bytes encoded as 64 hex characters or Base64.
DHAN_TOKEN_ENCRYPTION_KEY=""
DHAN_TOKEN_REFRESH_WINDOW_MINUTES="60"

# Pre-Surge V3 is research-only until its untouched holdout gates pass.
PRE_SURGE_V3_SHADOW="true"
DHAN_SANDBOX="false"

# Trading remains paper-only unless both controls are explicitly enabled.
PAPER_TRADING_MODE="true"
ENABLE_LIVE_TRADING="false"
ENABLE_AUTOMATION="false"

# Scheduled market scans are independent from paper-trade execution.
ENABLE_AUTO_SCAN="false"
ENABLE_EOD_PIPELINE="true"
SCAN_TIMEOUT_MS="600000"
SCANNER_UNIVERSE_LIMIT="500"
SCANNER_CONCURRENCY="12"
SCANNER_DEEP_CANDIDATE_LIMIT="30"

# Three-stage Pre-Surge upgrade. Early Buy is advisory/shadow by default;
# breakout execution still requires the live price/RVOL integrity checks.
EARLY_BUY_SHADOW="true"
EARLY_BUY_LIVE="false"

# Independent institutional discovery pool. Candidates are scanner inputs,
# never automatic BUY signals.
INSTITUTIONAL_LOOKBACK_DAYS="30"
INSTITUTIONAL_CANDIDATE_EXPIRY_DAYS="30"
INSTITUTIONAL_MIN_NET_CR="1"
INSTITUTIONAL_MIN_CANDIDATE_SCORE="45"
INSTITUTIONAL_SOURCE_TYPES="FII,DII"

# Batch ML ranking service (deploy Dockerfile.ml as a second Railway service).
# Safe defaults: features are logged, but no model can influence live ordering.
ML_RANKING_ENABLED="false"
ML_SERVICE_URL=""
ML_SERVICE_TOKEN=""
ML_SERVICE_TIMEOUT_MS="4000"
ML_FEATURE_LOGGING_ENABLED="true"
ML_TRIGGER_FEATURE_LOGGING_ENABLED="true"
ML_SHADOW_MODE="true"
ML_ALLOW_LIVE_RERANK="false"

# Optional bounded context analysis. It can explain/flag risk, but cannot
# change deterministic entries, stops, targets, trigger state or ML rank.
LLM_CONTEXT_ENABLED="false"
MARKET_DATA_TIMEOUT_MS="8000"
# Finalized EOD qualification data quality controls.
EOD_MIN_CANDLES="220"
EOD_READY_RATIO="0.80"
EOD_MIN_READY_SYMBOLS="50"
# Dhan is primary; this fallback is persisted and never uses a partial
# intraday daily candle for scheduled qualification.
EOD_ALLOW_YAHOO_BACKFILL="true"
# Optional comma-separated YYYY-MM-DD NSE holiday dates.
NSE_MARKET_HOLIDAYS=""

# ── Optional ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development         # set to "production" on server

# For Docker Compose only:
# POSTGRES_PASSWORD="your_db_password"
