// StockSage Pro - PostgreSQL schema.
// Development and production intentionally use the same database provider.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  mobileNumber String?  @unique
  name         String?
  password     String // bcrypt hashed
  mpinHash     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Subscription
  subscriptionStatus String    @default("TRIAL") // TRIAL | ACTIVE | FREE | EXPIRED
  subscriptionExpiry DateTime?

  // Notification preferences
  telegramChatId   String?
  notifyBuySignals Boolean @default(true)
  notifyEmail      Boolean @default(true)

  // Trading Capital & Position Sizing
  tradingCapital Float @default(500000) // ₹5L default
  maxRiskPct     Float @default(2.0) // 2% max risk per trade
  maxPositions   Int   @default(5) // Max simultaneous positions
  maxSectorConc  Int   @default(2) // Max stocks per sector in primary

  brokerConfig    BrokerConfig?
  trades          Trade[]
  screenerPresets ScreenerPreset[]
  watchlistItems  WatchlistItem[]
  deviceTokens    DeviceToken[]
  paymentOrders   PaymentOrder[]
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WatchlistItem {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  ticker          String
  sector          String?
  signal          String?
  ltp             Float?
  target          Float?
  stopLoss        Float?
  targetPct       Float?
  slPct           Float?
  riskReward      Float?
  confidenceScore Float?
  setupType       String?
  buyZone         Float?
  snapshot        Json?
  addedAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([userId])
}

model BrokerConfig {
  id                    String  @id @default(uuid()) @db.Uuid
  userId                String  @unique @db.Uuid
  provider              String
  apiKeyCiphertext      String
  apiSecretCiphertext   String
  accessTokenCiphertext String?
  isLive                Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortfolioConfig {
  id            String   @id @default("singleton")
  totalCapital  Float    @default(1000000) // ₹10L default
  riskPctLarge  Float    @default(1.0) // 1% per large/mid trade
  riskPctSmall  Float    @default(0.75) // 0.75% per small cap trade
  maxOpenTrades Int      @default(5)
  maxSectorConc Int      @default(2) // max stocks per sector
  updatedAt     DateTime @updatedAt
}

model Trade {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  // Stock info
  ticker      String
  companyName String?
  sector      String?
  capCategory String  @default("UNKNOWN") // LARGE | MID | SMALL
  setupType   String  @default("Manual")

  // Regime context at time of entry
  regimeAtEntry   String? // BULLISH | NEUTRAL | RISK_OFF
  confidenceScore Float? // 0-10

  // Execution
  status        String    @default("OPEN") // OPEN | CLOSED
  entryDate     DateTime  @default(now())
  exitDate      DateTime?
  entryPrice    Float
  quantity      Int
  stopLossInit  Float // Original stop loss
  stopLossTrail Float? // Trailing stop (updated over time)
  target1       Float
  target2       Float?
  exitPrice     Float?
  exitReason    String? // TARGET | STOP | TRAIL | MANUAL

  // Current price (updated on watch)
  currentPrice Float?

  // Computed on close
  pnlRs     Float? // Realized P&L in ₹
  pnlPct    Float? // Realized P&L %
  rMultiple Float? // P&L / Initial Risk

  // Risk metrics
  initialRiskRs   Float? // (entryPrice - stopLossInit) × quantity
  capitalDeployed Float? // entryPrice × quantity

  daysHeld Int?
  notes    String?

  // Trade journal: the plan at entry (from the setup), and the review on close
  plannedEntry      Float?
  plannedStop       Float?
  plannedTarget     Float?
  entryReason       String?
  emotionAtEntry    String? // CALM | CONFIDENT | ANXIOUS | FOMO | REVENGE
  followedPlan      Boolean?
  mistakes          String[]  @default([])
  grade             String? // A | B | C
  lesson            String?
  reviewedAt        DateTime?
  // Best and worst price while the trade was open (daily highs and lows)
  maxFavorablePrice Float?
  maxAdversePrice   Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([ticker])
  @@index([entryDate])
}

model ScreenerPreset {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  name      String
  filters   String
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HistoricalSetup {
  id              String  @id @default(uuid()) @db.Uuid
  ticker          String
  setupType       String
  timeframe       String?
  aiSignal        String  @default("WATCH")
  confidenceScore Float

  entryPrice  Float
  targetPrice Float
  stopLoss    Float
  aiLogic     String?

  status               String  @default("QUALIFIED") // QUALIFIED, TRIGGERED, IN_PROGRESS, WON, LOST
  // Scanner conviction is not execution. This flag is set only after price
  // reaches entryPrice (or an equivalent live trigger confirmation).
  triggerConfirmed     Boolean @default(false)
  // Intraday confirmation audit fields. triggerVolumeRatio is the required
  // threshold; triggeredVolumeRatio is the observed same-time RVOL at entry.
  triggerVolumeRatio   Float   @default(1.5)
  triggeredPrice       Float?
  triggeredVolumeRatio Float?
  resultPct            Float?

  // Lifecycle timestamps used by the dashboard and performance tracker.
  qualifiedAt DateTime  @default(now())
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  mlTriggerFeatureSnapshot MlTriggerFeatureSnapshot?
  tradePlan                TradePlan?

  @@index([status])
  @@index([ticker])
  @@index([qualifiedAt])
}

// A setup is a forecast; a TradePlan is the immutable execution boundary used
// to decide whether a live price is still buyable. activeKey is populated only
// while the plan is active, enforcing one live plan per ticker/strategy/timeframe.
model TradePlan {
  id                    String  @id @default(uuid()) @db.Uuid
  historicalSetupId     String  @unique @db.Uuid
  ticker                String
  strategyFamily        String
  strategyVersion       String  @default("PRE_SURGE_V2")
  shadowStrategyVersion String?
  shadowPlan            Json?
  timeframe             String
  status                String  @default("QUALIFIED")
  activeKey             String? @unique

  earlyEntryLow         Float?
  earlyEntryHigh        Float?
  breakoutPrice         Float
  maxBreakoutPrice      Float
  stopLoss              Float
  targetPrice           Float
  plannedRiskReward     Float
  earlyAllocationPct    Float    @default(30)
  breakoutAllocationPct Float    @default(70)
  expiresAt             DateTime

  openingPrice      Float?
  openingObservedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  historicalSetup HistoricalSetup       @relation(fields: [historicalSetupId], references: [id], onDelete: Cascade)
  attempts        TradeAttempt[]
  events          SetupLifecycleEvent[]

  @@index([ticker, strategyFamily, timeframe])
  @@index([status, expiresAt])
  @@index([shadowStrategyVersion])
}

// Every executable leg records the observed open, actual fill and actual exit.
// Performance is calculated from actualFillPrice, never from the planned pivot.
model TradeAttempt {
  id               String    @id @default(uuid()) @db.Uuid
  tradePlanId      String    @db.Uuid
  leg              String    @default("BREAKOUT") // EARLY | BREAKOUT
  status           String    @default("PENDING") // PENDING | FILLED | MISSED_GAP | WON | LOST | CANCELLED
  plannedEntryLow  Float
  plannedEntryHigh Float
  maxEntryPrice    Float
  openingPrice     Float?
  actualFillPrice  Float?
  actualFillAt     DateTime?
  triggerRvol      Float?
  exitPrice        Float?
  exitAt           DateTime?
  resultPct        Float?
  missReason       String?
  source           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tradePlan TradePlan             @relation(fields: [tradePlanId], references: [id], onDelete: Cascade)
  events    SetupLifecycleEvent[]

  @@unique([tradePlanId, leg])
  @@index([status, actualFillAt])
}

// Append-only audit trail for qualification, opening, fill, miss and outcome.
model SetupLifecycleEvent {
  id             String   @id @default(uuid()) @db.Uuid
  tradePlanId    String   @db.Uuid
  tradeAttemptId String?  @db.Uuid
  eventType      String
  fromStatus     String?
  toStatus       String
  observedPrice  Float?
  observedRvol   Float?
  observedAt     DateTime
  source         String
  metadata       Json?
  createdAt      DateTime @default(now())

  tradePlan    TradePlan     @relation(fields: [tradePlanId], references: [id], onDelete: Cascade)
  tradeAttempt TradeAttempt? @relation(fields: [tradeAttemptId], references: [id], onDelete: SetNull)

  @@index([tradePlanId, observedAt])
  @@index([eventType, observedAt])
}

// Point-in-time context captured by the lifecycle monitor at the exact moment
// price + same-time RVOL confirms entry. It is immutable training evidence for
// the post-trigger model and must never contain future target/stop information.
model MlTriggerFeatureSnapshot {
  id                      String   @id @default(uuid()) @db.Uuid
  historicalSetupId       String   @unique @db.Uuid
  qualificationSnapshotId String?  @db.Uuid
  ticker                  String
  triggeredAt             DateTime
  featureSchemaVersion    String
  source                  String
  triggerPrice            Float
  observedPrice           Float
  observedRvol            Float
  requiredRvol            Float
  baselineVolume          Float
  sampleCount             Int
  triggerBucket           String
  features                Json
  createdAt               DateTime @default(now())

  historicalSetup HistoricalSetup           @relation(fields: [historicalSetupId], references: [id], onDelete: Cascade)
  predictions     MlPostTriggerPrediction[]

  @@index([ticker, triggeredAt])
  @@index([triggeredAt])
}

model MlPostTriggerPrediction {
  id                 String   @id @default(uuid()) @db.Uuid
  triggerSnapshotId  String   @db.Uuid
  modelName          String
  modelVersion       String
  rankScore          Float?
  winProbability     Float?
  expectedR          Float?
  action             String   @default("SHADOW")
  shadow             Boolean  @default(true)
  productionEligible Boolean  @default(false)
  latencyMs          Int?
  createdAt          DateTime @default(now())

  triggerSnapshot MlTriggerFeatureSnapshot @relation(fields: [triggerSnapshotId], references: [id], onDelete: Cascade)

  @@unique([triggerSnapshotId, modelName, modelVersion])
  @@index([modelName, modelVersion, createdAt])
  @@index([shadow, productionEligible])
}

// Server-owned broker session. Access tokens are encrypted before storage;
// long-lived secrets (PIN, TOTP seed, encryption key) remain in Railway's
// secret store and are never persisted in PostgreSQL.
model BrokerAuthSession {
  provider              String    @id
  accessTokenCiphertext String
  expiresAt             DateTime
  tokenSource           String
  status                String    @default("ACTIVE") // ACTIVE | ERROR
  lastValidatedAt       DateTime?
  lastRefreshAt         DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, expiresAt])
}

// Canonical end-of-day market data used by the qualification scanner. The
// scanner reads finalized rows from PostgreSQL instead of rebuilding its
// history from a partial intraday Yahoo candle on every scheduled run.
model MarketInstrument {
  symbol          String    @id
  securityId      String?
  exchangeSegment String    @default("NSE_EQ")
  instrumentType  String    @default("EQUITY")
  series          String    @default("EQ")
  isin            String?
  isActive        Boolean   @default(true)
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dailyCandles DailyCandle[]

  @@index([securityId])
  @@index([isActive])
}

model DailyCandle {
  symbol        String
  tradingDate   DateTime @db.Date
  open          Float
  high          Float
  low           Float
  close         Float
  previousClose Float?
  volume        BigInt
  turnoverCr    Float?
  totalTrades   Int?
  deliveryQty   BigInt?
  deliveryPct   Float?
  source        String
  isFinal       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instrument MarketInstrument @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@id([symbol, tradingDate])
  @@index([tradingDate, isFinal])
  @@index([tradingDate, turnoverCr])
}

/// Split, bonus and consolidation events used to adjust historical prices.
/// Raw DailyCandle rows are never modified; adjustment is applied on read.
/// priceFactor multiplies every price before exDate (0.5 for a 1:1 bonus or
/// 2-for-1 split); volume before exDate is divided by it.
model CorporateAction {
  id          String   @id @default(uuid()) @db.Uuid
  symbol      String
  exDate      DateTime @db.Date
  kind        String // SPLIT | BONUS | CONSOLIDATION
  ratio       String // e.g. "2:1" new shares for old
  priceFactor Float
  source      String // YAHOO_SPLITS | MANUAL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([symbol, exDate, source])
  @@index([symbol, exDate])
}

/// Replay evidence and trust status per scanner setup type
/// (reports/setup-trust-rules.md). One row per setup type and method version.
model SetupEvidence {
  id            String   @id @default(uuid()) @db.Uuid
  setupType     String
  methodVersion String
  status        String // RESEARCH_ONLY | ON_TRIAL | TRUSTED
  reasons       Json
  discovery     Json
  test          Json
  testYears     Json
  signals       Json // signal, trigger, chase-skip counts
  goalRateTest  Float? // share of test trades reaching +5% before the stop
  generatedAt   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([setupType, methodVersion])
  @@index([status])
}

/// Live paper tracking of On-trial / Trusted setups (reports/setup-trust-rules.md).
/// Resolved with the same rules as the historical replay; no orders are placed.
model PaperSignal {
  id               String    @id @default(uuid()) @db.Uuid
  ticker           String
  setupType        String
  signalDate       DateTime  @db.Date
  scanId           String?
  entryPrice       Float
  stopLoss         Float
  targetPrice      Float
  atr14            Float
  triggerMode      String
  statusAtSignal   String // trust status of the setup type when recorded
  state            String // PENDING | OPEN | TARGET | STOP | EXPIRED | NOT_TRIGGERED | SKIPPED_CHASE
  fillDate         DateTime? @db.Date
  fillPrice        Float?
  exitDate         DateTime? @db.Date
  exitPrice        Float?
  netR             Float?
  reachedGoalFirst Boolean?
  lastCheckedDate  DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([ticker, setupType, signalDate])
  @@index([state])
  @@index([setupType, state])
}

model EodIngestionRun {
  id                       String    @id @default(uuid()) @db.Uuid
  tradingDate              DateTime  @unique @db.Date
  status                   String    @default("RUNNING") // RUNNING | READY | PARTIAL | FAILED
  source                   String    @default("NSE_UDIFF_DHAN")
  symbolCount              Int       @default(0)
  readySymbolCount         Int       @default(0)
  minimumCandles           Int       @default(220)
  message                  String?
  errors                   Json?
  startedAt                DateTime  @default(now())
  completedAt              DateTime?
  qualificationQueuedAt    DateTime?
  qualificationScanId      String?   @db.Uuid
  qualificationCompletedAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([status, tradingDate])
}

model InstitutionalFlowSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  tradingDate DateTime @unique
  fiiBuy      Float
  fiiSell     Float
  fiiNet      Float
  diiBuy      Float
  diiSell     Float
  diiNet      Float
  totalNet    Float
  marketBias  String
  source      String   @default("NSE")
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tradingDate])
}

model InstitutionalDeal {
  id          String   @id @default(uuid()) @db.Uuid
  symbol      String
  companyName String
  clientName  String
  entityType  String // "FII" | "DII" | "PROMOTER" | "HNI" | "ARBITRAGE" | "OTHER"
  dealType    String // "BUY" | "SELL"
  quantity    Int
  price       Float
  totalValue  Float // (quantity * price) in ₹ Crores
  remarks     String?
  tradeDate   DateTime
  createdAt   DateTime @default(now())

  @@index([symbol, tradeDate])
  @@index([entityType, tradeDate])
  @@index([dealType])
}

model InstitutionalConfluence {
  id               String   @id @default(uuid()) @db.Uuid
  symbol           String   @unique
  companyName      String?
  tradeDate        DateTime
  netFiiBuyCr      Float    @default(0)
  netDiiBuyCr      Float    @default(0)
  technicalPattern String? // e.g. "VCP_BREAKOUT", "VOLUME_SURGE"
  confluenceScore  Int      @default(0) // 0 - 100
  isSuperSignal    Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@index([confluenceScore])
  @@index([isSuperSignal])
}

model PaymentOrder {
  id              String    @id @default(uuid()) @db.Uuid
  providerOrderId String    @unique
  userId          String    @db.Uuid
  planId          String
  amountPaise     Int
  currency        String    @default("INR")
  status          String    @default("CREATED") // CREATED | PAID | FAILED | REFUNDED
  paymentId       String?   @unique
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Durable lifecycle and result record for manual and scheduled market scans.
// The result JSON lets every API instance recover the last successful scan
// after a restart instead of relying on Railway's ephemeral filesystem.
model ScanJob {
  id              String    @id @default(uuid()) @db.Uuid
  mode            String    @default("swing")
  trigger         String
  requestedBy     String?   @db.Uuid
  status          String    @default("QUEUED")
  stage           String    @default("Queued")
  message         String?
  progressPct     Int       @default(0)
  processedStocks Int       @default(0)
  totalStocks     Int       @default(0)
  setupsFound     Int       @default(0)
  result          Json?
  error           String?
  startedAt       DateTime?
  heartbeatAt     DateTime?
  deadlineAt      DateTime?
  completedAt     DateTime?
  durationMs      Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([mode, status])
  @@index([mode, completedAt])
  @@index([createdAt])
}

model InstitutionalFlow {
  id           String   @id @default(uuid()) @db.Uuid
  symbol       String
  date         DateTime
  clientName   String
  buySell      String // "BUY" | "SELL"
  quantity     Int
  avgPrice     Float
  totalValueCr Float    @default(0)
  isHftNoise   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([symbol, date])
  @@index([isHftNoise])
  @@map("institutional_flows")
}

model InstitutionalCandidatePool {
  id                   String    @id @default(uuid()) @db.Uuid
  symbol               String    @unique
  addedAt              DateTime  @default(now())
  lastAccumulationDate DateTime
  netInstitutionalQty  Int
  netInstitutionalCr   Float
  deliverySpikeRatio   Float     @default(0)
  deliveryPct          Float     @default(0)
  institutionalScore   Float     @default(0)
  liquidityScore       Float     @default(0)
  candidateScore       Float     @default(0)
  sourceTypes          String[]  @default([])
  status               String    @default("ACTIVE") // ACTIVE | EXPIRED | REJECTED
  expiresAt            DateTime?
  lastEvaluatedAt      DateTime  @default(now())
  rejectionReason      String?
  updatedAt            DateTime  @updatedAt

  @@index([status, candidateScore])
  @@index([lastAccumulationDate])
  @@map("institutional_candidate_pool")
}

// Immutable, point-in-time ML inputs. Features are stored exactly as sent to
// the ranker so every prediction can be reproduced and audited later.
model MlFeatureSnapshot {
  id                   String   @id @default(uuid()) @db.Uuid
  batchId              String   @db.Uuid
  scanJobId            String?  @db.Uuid
  ticker               String
  asOf                 DateTime
  featureSchemaVersion String
  deterministicScore   Float
  features             Json
  createdAt            DateTime @default(now())

  predictions MlPrediction[]
  outcome     MlOutcome?

  @@unique([batchId, ticker])
  @@index([ticker, asOf])
  @@index([scanJobId])
}

model MlPrediction {
  id                        String   @id @default(uuid()) @db.Uuid
  featureSnapshotId         String   @db.Uuid
  modelName                 String
  modelVersion              String
  modelRole                 String // CHAMPION | CHALLENGER | BASELINE
  rankScore                 Float?
  winProbability            Float?
  triggerProbability        Float?
  conditionalWinProbability Float?
  expectedR                 Float?
  rank                      Int?
  action                    String   @default("SHADOW")
  shadow                    Boolean  @default(true)
  productionEligible        Boolean  @default(false)
  latencyMs                 Int?
  createdAt                 DateTime @default(now())

  featureSnapshot MlFeatureSnapshot @relation(fields: [featureSnapshotId], references: [id], onDelete: Cascade)

  @@unique([featureSnapshotId, modelName, modelVersion])
  @@index([modelName, modelVersion, createdAt])
  @@index([shadow, productionEligible])
}

model MlOutcome {
  id                 String    @id @default(uuid()) @db.Uuid
  featureSnapshotId  String    @unique @db.Uuid
  historicalSetupId  String?   @db.Uuid
  outcome            String // WON | LOST | EXPIRED | CANCELLED
  returnPct          Float?
  rMultiple          Float?
  triggered          Boolean   @default(false)
  triggeredAt        DateTime?
  daysToTrigger      Int?
  postTriggerOutcome String? // WON | LOST | TIME_EXIT
  timeExit           Boolean   @default(false)
  maximumR           Float?
  minimumR           Float?
  resolvedAt         DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  featureSnapshot MlFeatureSnapshot @relation(fields: [featureSnapshotId], references: [id], onDelete: Cascade)

  @@index([outcome, resolvedAt])
  @@index([triggered, postTriggerOutcome])
  @@index([historicalSetupId])
}

model MlModelVersion {
  id                   String    @id @default(uuid()) @db.Uuid
  modelName            String
  version              String
  role                 String // CHAMPION | CHALLENGER | BASELINE
  status               String    @default("SHADOW") // SHADOW | APPROVED | REJECTED | RETIRED
  featureSchemaVersion String
  artifactUri          String?
  datasetHash          String?
  trainingWindowStart  DateTime?
  trainingWindowEnd    DateTime?
  metrics              Json?
  promotionReport      Json?
  productionEligible   Boolean   @default(false)
  createdAt            DateTime  @default(now())
  promotedAt           DateTime?

  @@unique([modelName, version])
  @@index([role, status])
  @@index([productionEligible])
}

model SignalLabsAlert {
  id                 String   @id @default(uuid()) @db.Uuid
  symbol             String
  alertDate          DateTime
  breakoutPrice      Float
  targetPrice        Float // breakoutPrice * 1.08
  stopLossPrice      Float // candleLow * 0.97
  technicalScore     Float // e.g. 8.5/10
  fiiDiiNetQty       Int      @default(0)
  deliverySpikeRatio Float    @default(0)
  setupType          String   @default("INSTITUTIONAL_BREAKOUT")
  createdAt          DateTime @default(now())

  @@index([symbol, alertDate])
  @@map("signal_labs_alerts")
}
