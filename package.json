{
    "name": "swingedge",
    "version": "2.0.0",
    "description": "SwingEdge — Your Quantitative Edge in the Indian Market",
    "main": "dist/index.js",
    "scripts": {
        "dev:personal": "cross-env SWINGDESK_PERSONAL_MODE=true SWINGDESK_DATA_PROVIDER=yahoo SCANNER_UNIVERSE=nifty500 NODE_ENV=development PAPER_TRADING_MODE=true ENABLE_LIVE_TRADING=false ENABLE_AUTOMATION=false ENABLE_AUTO_SCAN=true ENABLE_EOD_PIPELINE=true SCANNER_UNIVERSE_LIMIT=500 SCANNER_DEEP_CANDIDATE_LIMIT=12 SCAN_TIMEOUT_MS=1200000 concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "build": "npx prisma generate && tsc",
        "build:full": "npm ci --include=dev && npm --prefix apex-intelligence ci && npm --prefix apex-intelligence run build && npm run build",
        "start": "npx cross-env NODE_ENV=production node dist/index.js",
        "dev:server": "ts-node-dev --respawn --transpile-only src/index.ts",
        "dev:client": "cd apex-intelligence && npm run dev",
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "backtest": "ts-node --transpile-only backtest.ts",
        "test": "vitest run",
        "prep-backtest": "ts-node --transpile-only src/backtestDataPrep.ts",
        "market:download": "ts-node --transpile-only src/nseHistoricalBackfill.ts",
        "market:backfill": "ts-node --transpile-only src/nseHistoricalBackfill.ts --import",
        "ml:export": "ts-node --transpile-only src/mlTrainingExport.ts",
        "ml:trigger-export": "ts-node --transpile-only src/mlTriggerTrainingExport.ts",
        "ml:trigger-train": "ts-node --transpile-only src/mlPostTriggerTrain.ts",
        "ml:replay": "ts-node --transpile-only src/mlHistoricalReplay.ts",
        "ml:train": "ts-node --transpile-only src/mlTrain.ts",
        "ml:sync-registry": "ts-node --transpile-only src/mlModelRegistrySync.ts",
        "execution:audit": "ts-node --transpile-only src/executionAudit.ts",
        "report:setups": "ts-node --transpile-only src/setupValidationReport.ts",
        "data:corporate-actions": "ts-node --transpile-only src/corporateActionSync.ts",
        "data:results-calendar": "ts-node --transpile-only src/resultsCalendarBackfill.ts",
        "research:five-pct": "node --max-old-space-size=4096 -r ts-node/register/transpile-only src/research/runFivePercentStudy.ts",
        "research:volatility-exits": "node --max-old-space-size=6144 -r ts-node/register/transpile-only src/research/runVolatilityExitStudy.ts",
        "research:setup-evidence": "node --max-old-space-size=6144 -r ts-node/register/transpile-only src/research/runSetupEvidence.ts",
        "paper:track": "ts-node --transpile-only src/paperTrackerCli.ts",
        "research:momentum-pullback": "node --max-old-space-size=6144 -r ts-node/register/transpile-only src/research/runMomentumPullback.ts",
        "research:post-results-drift": "node --max-old-space-size=6144 -r ts-node/register/transpile-only src/research/runPostResultsDrift.ts",
        "research:recent-gainers": "ts-node --transpile-only src/research/recentGainers.ts",
        "universe:refresh": "node scripts/refresh-nifty500.cjs",
        "backtest:presurge-v2:signals": "ts-node --transpile-only src/preSurgeV2Replay.ts",
        "backtest:presurge-v2:download": "ts-node --transpile-only src/dhanPreSurgeIntradayBackfill.ts",
        "backtest:presurge-v2:run": "ts-node --transpile-only src/preSurgeV2IntradayBacktest.ts",
        "backtest:presurge-v3:run": "ts-node --transpile-only src/preSurgeV3IntradayBacktest.ts",
        "backtest:presurge-v4:run": "ts-node --transpile-only src/preSurgeV4IntradayBacktest.ts",
        "backtest:sample": "cross-env BACKTEST_UNIVERSE_MODE=sample ts-node --transpile-only backtest.ts",
        "backtest:universe": "cross-env BACKTEST_UNIVERSE_MODE=broad_india BACKTEST_UNIVERSE_ONLY=1 ts-node --transpile-only backtest.ts",
        "research:next-day-clues": "node --max-old-space-size=6144 -r ts-node/register/transpile-only src/research/nextDayClues.ts",
        "research:uptrend-dip": "node --max-old-space-size=6144 -r ts-node/register/transpile-only src/research/runUptrendDip.ts",
        "research:forward-check": "node --max-old-space-size=4096 -r ts-node/register/transpile-only src/research/forwardCheck.ts",
        "research:harness-check": "node --max-old-space-size=6144 -r ts-node/register/transpile-only src/research/cards/uptrendDipCheck.ts",
        "data:freshness": "ts-node --transpile-only src/dataFreshness.ts",
        "nightly:research": "node --max-old-space-size=4096 -r ts-node/register/transpile-only src/nightlyResearch.ts",
        "research:sector-momentum": "node --max-old-space-size=8192 -r ts-node/register/transpile-only src/research/cards/sectorMomentum.ts",
        "data:global": "ts-node --transpile-only src/globalMarketBackfill.ts",
        "data:intraday-pilot": "ts-node --transpile-only src/research/intradayPilot.ts",
        "data:intraday-backfill": "node --max-old-space-size=6144 -r ts-node/register/transpile-only src/research/intradayBackfill.ts",
        "research:global-cues": "node --max-old-space-size=8192 -r ts-node/register/transpile-only src/research/cards/globalCues.ts",
        "research:institutional-buys": "node --max-old-space-size=8192 -r ts-node/register/transpile-only src/research/cards/institutionalBuys.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.78.0",
        "@google/generative-ai": "^0.24.1",
        "@prisma/client": "^5.22.0",
        "@tensorflow/tfjs": "^4.22.0",
        "@types/adm-zip": "^0.5.7",
        "@types/node-telegram-bot-api": "^0.64.14",
        "@types/nodemailer": "^7.0.11",
        "@types/ws": "^8.18.2",
        "adm-zip": "^0.6.0",
        "axios": "^1.6.7",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "cross-env": "^7.0.3",
        "csv-parse": "^6.1.0",
        "dotenv": "^17.3.1",
        "express": "^4.22.3",
        "express-rate-limit": "^8.3.1",
        "jsonwebtoken": "^9.0.3",
        "kiteconnect": "^5.3.0",
        "lowdb": "^1.0.0",
        "node-cron": "^4.6.0",
        "node-telegram-bot-api": "^1.2.0",
        "nodemailer": "^10.1.4",
        "prisma": "^5.22.0",
        "puppeteer-core": "^25.4.0",
        "technicalindicators": "^3.1.0",
        "twilio": "^5.13.1",
        "ws": "^8.23.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/lowdb": "^1.0.15",
        "@types/node": "^20.19.33",
        "@types/node-cron": "^3.0.11",
        "concurrently": "^9.2.1",
        "prisma": "^5.22.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3",
        "vitest": "^3.2.4"
    },
    "overrides": {
        "serialize-javascript": "7.0.5",
        "js-yaml": "4.3.1"
    }
}
